# Configuration files with sensitive data
include/config.php
include/config.local.php

# Log files
logs/*.log
*.log

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# IDE and editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Backup files (except version backups)
backup_current_*
*.bak
*.backup

# Uploaded files (user content)
upload/*
!upload/.gitkeep
fichiers/*
!fichiers/.gitkeep

# Database dumps
*.sql
*.dump

# Composer
vendor/
composer.lock

# Node modules (if any)
node_modules/
npm-debug.log
yarn-error.log

# Environment files
.env
.env.local
.env.production

# Cache files
cache/
*.cache

# Session files
sessions/

# Error logs
error_log
access_log

# Backup directories (keep version backups)
# backup_v1.0.0.1/ and backup_v1.0.0.2/ are intentionally not ignored
